---
layout: base.njk
title: Admin Dashboard - Golden Wings
description: Manage site settings and view RSVP statistics
permalink: /admin/
---

<div id="admin-app"
     class="min-h-screen bg-slate-950/5 py-10"
     data-endpoint="{{ siteConfig.admin.analyticsEndpoint }}"
     data-deployment-docs="{{ siteConfig.admin.deploymentDocs }}"
     data-webhook="{{ siteConfig.form.webhookUrl }}">
  <div class="container mx-auto px-4 space-y-10">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-blue-900 to-sky-600 text-white rounded-3xl shadow-xl p-10">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
        <div>
          <p class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 text-xs uppercase tracking-widest mb-4">
            DigitalOcean Ops Center
          </p>
          <h1 class="text-4xl lg:text-5xl font-bold mb-3">Golden Wings Command Console</h1>
          <p class="text-lg text-white/80 max-w-2xl">
            Monitor RSVP momentum, sync screening details, and trigger DigitalOcean deployments—all from one secure backend hub.
          </p>
        </div>
        <div class="bg-slate-900/50 rounded-2xl p-6 min-w-[220px]">
          <p class="text-xs uppercase tracking-widest text-white/60">Next Screening</p>
          <p class="text-2xl font-bold" id="header-event-date">{{ siteConfig.event.date }}</p>
          <p class="text-sm text-white/70">{{ siteConfig.event.timePST }} PST · {{ siteConfig.event.venue }}</p>
        </div>
      </div>
    </div>

    <!-- Live Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
      <div class="bg-white shadow-lg rounded-2xl p-6 border border-slate-200/60">
        <p class="text-sm font-medium text-slate-500">Total RSVPs</p>
        <p class="text-4xl font-bold text-slate-900 mt-3" id="stat-total">--</p>
        <p class="text-xs text-slate-400 mt-2">Combined RSVPs captured across all channels</p>
      </div>
      <div class="bg-white shadow-lg rounded-2xl p-6 border border-slate-200/60">
        <p class="text-sm font-medium text-slate-500">Confirmed Guests</p>
        <p class="text-4xl font-bold text-emerald-600 mt-3" id="stat-confirmed">--</p>
        <p class="text-xs text-slate-400 mt-2">Status synced from Google Sheets admin workflow</p>
      </div>
      <div class="bg-white shadow-lg rounded-2xl p-6 border border-slate-200/60">
        <p class="text-sm font-medium text-slate-500">New This Week</p>
        <p class="text-4xl font-bold text-indigo-600 mt-3" id="stat-week">--</p>
        <p class="text-xs text-slate-400 mt-2">Rolling seven-day RSVP volume</p>
      </div>
      <div class="bg-white shadow-lg rounded-2xl p-6 border border-slate-200/60">
        <p class="text-sm font-medium text-slate-500">Days to Event</p>
        <p class="text-4xl font-bold text-orange-500 mt-3" id="days-until">--</p>
        <p class="text-xs text-slate-400 mt-2">Automatically recalculated every sync</p>
      </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
      <div class="xl:col-span-2 space-y-6">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200/60 p-6">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
            <div>
              <h2 class="text-2xl font-semibold text-slate-900">Operations Status</h2>
              <p class="text-sm text-slate-500">Realtime insight sourced from Google Sheets on DigitalOcean</p>
            </div>
            <div class="text-right">
              <p class="text-xs uppercase tracking-widest text-slate-400">Last Synced</p>
              <p class="text-sm font-medium text-slate-600" id="last-sync">Awaiting data…</p>
            </div>
          </div>
          <div id="sync-banner" class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 text-slate-600 text-sm">
            Initializing secure connection to Google Apps Script…
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-slate-200/60">
          <div class="border-b border-slate-200 px-6 py-4 flex items-center justify-between">
            <div>
              <h2 class="text-xl font-semibold text-slate-900">Recent RSVPs</h2>
              <p class="text-sm text-slate-500">Live snapshot of the latest confirmations flowing into the sheet</p>
            </div>
            <a href="https://docs.google.com/spreadsheets/d/1tepMKJ6WLnXCmfmkV_tmDfSg_Qkgl6xF3KBtFu6gXMM"
               target="_blank"
               class="inline-flex items-center px-4 py-2 rounded-lg bg-emerald-500 text-white text-sm font-medium hover:bg-emerald-600">
              Open Master Sheet
            </a>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-left">
              <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                <tr>
                  <th scope="col" class="px-6 py-3">Name</th>
                  <th scope="col" class="px-6 py-3">Email</th>
                  <th scope="col" class="px-6 py-3">Status</th>
                  <th scope="col" class="px-6 py-3">Received</th>
                </tr>
              </thead>
              <tbody id="rsvp-table-body" class="divide-y divide-slate-100 text-sm text-slate-600">
                <tr>
                  <td colspan="4" class="px-6 py-10 text-center text-slate-400">Waiting for sync…</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200/60 p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold text-slate-900">Event Snapshot</h2>
            <span class="px-3 py-1 text-xs rounded-full bg-blue-100 text-blue-600 font-semibold">Live</span>
          </div>
          <dl class="space-y-3 text-sm text-slate-600">
            <div class="flex justify-between"><dt>Date</dt><dd id="event-date" class="font-medium text-slate-900">{{ siteConfig.event.date }}</dd></div>
            <div class="flex justify-between"><dt>Primary Time</dt><dd id="event-time" class="font-medium text-slate-900">{{ siteConfig.event.timePST }} PST</dd></div>
            <div class="flex justify-between"><dt>Additional Zones</dt><dd class="font-medium text-slate-900">{{ siteConfig.event.timeCST }} CST · {{ siteConfig.event.timeEST }} EST</dd></div>
            <div class="flex justify-between"><dt>Venue</dt><dd id="event-venue" class="font-medium text-slate-900 text-right">{{ siteConfig.event.venue }}</dd></div>
            <div class="flex justify-between"><dt>Duration</dt><dd id="event-duration" class="font-medium text-slate-900">{{ siteConfig.event.duration }}</dd></div>
          </dl>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-slate-200/60 p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold text-slate-900">Webhook &amp; Deploy</h2>
            <span class="px-3 py-1 text-xs rounded-full bg-emerald-100 text-emerald-600 font-semibold">Automation</span>
          </div>
          <div class="space-y-3 text-sm text-slate-600">
            <div>
              <p class="font-medium text-slate-900 mb-1">Apps Script Webhook</p>
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 font-mono text-xs break-all">
                {{ siteConfig.form.webhookUrl }}
              </div>
              <button type="button"
                      class="mt-2 inline-flex items-center px-3 py-1.5 text-xs font-semibold bg-slate-900 text-white rounded-md hover:bg-slate-800"
                      data-copy-button>
                Copy URL
              </button>
            </div>
            <div class="pt-2 border-t border-dashed border-slate-200">
              <p class="font-medium text-slate-900 mb-1">DigitalOcean Deployment</p>
              <p class="text-xs text-slate-500 mb-3">Push commits to <span class="font-semibold">main</span> to trigger an automatic rebuild on App Platform.</p>
              <a id="deployment-docs"
                 href="{{ siteConfig.admin.deploymentDocs }}"
                 target="_blank"
                 class="inline-flex items-center px-4 py-2 rounded-lg border border-slate-900 text-slate-900 text-xs font-semibold hover:bg-slate-900 hover:text-white transition">
                Deployment Guide
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Settings Tabs -->
    <div class="bg-white rounded-3xl shadow-xl border border-slate-200/60 overflow-hidden">
      <div class="border-b border-gray-200">
        <nav class="flex">
          <button class="tab-button active px-6 py-4 font-medium" data-tab="event">Event Details</button>
          <button class="tab-button px-6 py-4 font-medium" data-tab="video">Video Settings</button>
          <button class="tab-button px-6 py-4 font-medium" data-tab="form">Form Settings</button>
          <button class="tab-button px-6 py-4 font-medium" data-tab="rsvps">RSVP Feed</button>
        </nav>
      </div>

      <div class="p-8">
        <!-- Event Details Tab -->
        <div id="tab-event" class="tab-content">
          <h2 class="text-2xl font-bold mb-6">Event Details</h2>
          <form id="event-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Event Title</label>
                <input type="text" name="title" value="{{ siteConfig.event.title }}"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Subtitle</label>
                <input type="text" name="subtitle" value="{{ siteConfig.event.subtitle }}"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Event Date</label>
                <input type="text" name="date" value="{{ siteConfig.event.date }}"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Duration</label>
                <input type="text" name="duration" value="{{ siteConfig.event.duration }}"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Time (PST)</label>
                <input type="text" name="timePST" value="{{ siteConfig.event.timePST }}"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Time (CST)</label>
                <input type="text" name="timeCST" value="{{ siteConfig.event.timeCST }}"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Time (EST)</label>
                <input type="text" name="timeEST" value="{{ siteConfig.event.timeEST }}"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Venue</label>
                <input type="text" name="venue" value="{{ siteConfig.event.venue }}"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
              <textarea name="description" rows="4"
                        class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">{{ siteConfig.event.description }}</textarea>
            </div>
            <div class="flex justify-end space-x-4">
              <button type="button" class="px-6 py-2 border rounded-lg hover:bg-gray-50">Cancel</button>
              <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Save Changes</button>
            </div>
          </form>
        </div>

        <!-- Video Settings Tab -->
        <div id="tab-video" class="tab-content hidden">
          <h2 class="text-2xl font-bold mb-6">Video Background Settings</h2>
          <form id="video-form" class="space-y-6">
            <div class="flex items-center space-x-4 mb-6">
              <label class="flex items-center cursor-pointer">
                <input type="checkbox" name="enabled" {{ 'checked' if siteConfig.video.enabled }}
                       class="w-5 h-5 rounded border-gray-300 focus:ring-2 focus:ring-blue-500">
                <span class="ml-3 text-sm font-medium text-gray-700">Enable Background Video</span>
              </label>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Overlay Opacity (%)</label>
              <div class="flex items-center space-x-4">
                <input type="range" name="overlayOpacity" min="0" max="100" value="{{ siteConfig.video.overlayOpacity }}"
                       class="flex-1" id="opacity-slider">
                <span id="opacity-value" class="text-lg font-medium w-16">{{ siteConfig.video.overlayOpacity }}%</span>
              </div>
              <p class="mt-2 text-sm text-gray-500">Higher values make text more readable but darken the video</p>
            </div>
            <div class="flex items-center space-x-4">
              <label class="flex items-center cursor-pointer">
                <input type="checkbox" name="hideOnMobile" {{ 'checked' if siteConfig.video.hideOnMobile }}
                       class="w-5 h-5 rounded border-gray-300 focus:ring-2 focus:ring-blue-500">
                <span class="ml-3 text-sm font-medium text-gray-700">Hide video on mobile devices (better performance)</span>
              </label>
            </div>
            <div class="flex justify-end space-x-4">
              <button type="button" class="px-6 py-2 border rounded-lg hover:bg-gray-50">Cancel</button>
              <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Save Changes</button>
            </div>
          </form>
        </div>

        <!-- Form Settings Tab -->
        <div id="tab-form" class="tab-content hidden">
          <h2 class="text-2xl font-bold mb-6">Form & Integration Settings</h2>
          <form id="form-settings" class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Webhook URL</label>
              <input type="url" name="webhookUrl" value="{{ siteConfig.form.webhookUrl }}"
                     class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 font-mono text-sm">
              <p class="mt-2 text-sm text-gray-500">Google Apps Script webhook endpoint</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Contact Email</label>
              <input type="email" name="email" value="{{ siteConfig.contact.email }}"
                     class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex justify-end space-x-4">
              <button type="button" class="px-6 py-2 border rounded-lg hover:bg-gray-50">Cancel</button>
              <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Save Changes</button>
            </div>
          </form>
        </div>

        <!-- RSVPs Tab -->
        <div id="tab-rsvps" class="tab-content hidden">
          <div class="space-y-4">
            <p class="text-sm text-slate-600">This tab mirrors the live feed above and links directly into Google Sheets for deeper edits.</p>
            <div class="bg-slate-50 border border-dashed border-slate-300 rounded-xl p-6 text-sm text-slate-600">
              <p class="font-semibold text-slate-900 mb-2">Sync Targets</p>
              <ul class="list-disc list-inside space-y-1">
                <li>Total RSVPs and confirmed counts update on every refresh.</li>
                <li>Recent RSVP table shows the 10 latest confirmations.</li>
                <li>Push updates to GitHub → DigitalOcean rebuild publishes new messaging instantly.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Instructions -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
      <h3 class="text-lg font-semibold text-amber-900 mb-2">Deployment Workflow</h3>
      <p class="text-sm text-amber-700">
        Export settings, commit the refreshed <code class="bg-amber-100 px-1.5 py-0.5 rounded">siteConfig.json</code> file, and push to GitHub to kick off the DigitalOcean App Platform build. The webhook keeps RSVP data flowing while the static site refreshes.
      </p>
    </div>
  </div>
</div>

<style>
  .tab-button {
    color: #6b7280;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }
  .tab-button:hover {
    color: #1f2937;
    background: #f9fafb;
  }
  .tab-button.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
    background: #eff6ff;
  }
</style>
